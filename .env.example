# MEME base de donnees que le bot (obligatoire pour que le panel edite la meme config)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# OAuth2 Discord (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Genere avec: openssl rand -base64 32
NEXTAUTH_SECRET=
# En prod, l'URL de ton deploiement Vercel, ex: https://mon-bot.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ID du bot (pour vérifier quels serveurs il gère - meme valeur que DISCORD_CLIENT_ID du bot)
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=TON_CLIENT_ID&permissions=8&scope=bot%20applications.commands

# TOKEN DU BOT (Developer Portal > Bot > Reset Token) - EXACTEMENT la meme valeur que
# DISCORD_TOKEN dans bot/.env, juste renseignee ici sous un autre nom de variable.
# Necessaire pour que l'editeur d'embeds du panel puisse lister les salons et publier des messages
# directement depuis le web, sans passer par le process du bot.
DISCORD_TOKEN=
